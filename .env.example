# Server Configuration
PORT=8000
ENV=development

# Database Configuration (Defaults to local SQLite WAL mode)
DATABASE_URL=sqlite:///./gateway.db

# Master Admin Secret Key (Used to create virtual keys and inspect usage)
ADMIN_SECRET_KEY=dev-admin-secret-change-in-production

# LLM Provider Credentials
# Primary Provider: Groq (https://console.groq.com)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
PRIMARY_MODEL=llama-3.3-70b-versatile

# Fallback Provider: Google Gemini (https://aistudio.google.com)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
FALLBACK_MODEL=gemini-1.5-flash

# Resilience & Timeouts
REQUEST_TIMEOUT_SECONDS=15.0
ENABLE_MOCK_FALLBACK=true

# Cache Configuration (Stretch Goal)
CACHE_TTL_SECONDS=3600
CACHE_ENABLED=true

